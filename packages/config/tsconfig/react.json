{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Pulse Chat React application (bundled by Vite)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "noEmit": true
  }
}
