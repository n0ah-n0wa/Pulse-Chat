{
  "name": "@pulse-chat/api",
  "version": "0.0.0",
  "private": true,
  "description": "Pulse Chat NestJS backend",
  "license": "MIT",
  "scripts": {
    "dev": "node --watch --enable-source-maps --require @swc-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@pulse-chat/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@pulse-chat/config": "workspace:*",
    "@pulse-chat/eslint-config": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.0",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.10"
  }
}
