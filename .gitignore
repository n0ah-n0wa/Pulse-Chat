# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Caches
.turbo/
.cache/
.eslintcache
.vite/

# Test output
coverage/
test-results/
playwright-report/
e2e/.storage/

# Local attachment/avatar files (FILE_STORAGE_PATH). Do not use a blanket
# **/storage/ pattern: the API source lives under infrastructure/storage/.
/storage/
/apps/api/storage/

# Environment (never commit secrets; commit *.example files instead)
.env
.env.*
!.env.example
!.env.production.example

# TLS inspection roots used for local image builds: generated per machine,
# see infrastructure/docker/certs/README.md
infrastructure/docker/certs/*.crt
infrastructure/docker/certs/*.pem

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Editors and OS
.idea/
.DS_Store
Thumbs.db
*.swp
