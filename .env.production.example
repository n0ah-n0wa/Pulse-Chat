# Copy to .env.production and override before a real deployment.
# Interpolation (not container env_file) is what docker-compose.prod.yml reads:
#
#   docker compose --env-file .env.production -f docker-compose.prod.yml up --build
#
# `docker compose -f docker-compose.prod.yml up --build` also works: the compose
# file supplies local-demo defaults. Those defaults are not production secrets.

# Browser origin nginx publishes. Must match CORS_ORIGIN inside the API.
PULSE_PUBLIC_ORIGIN=http://localhost:8080

# MongoDB root user (authSource=admin). Use URL-safe characters only.
PULSE_MONGO_USER=pulse
PULSE_MONGO_PASSWORD=pulse-prod-mongo-change-me

# Redis AUTH password. Use URL-safe characters only.
PULSE_REDIS_PASSWORD=pulse-prod-redis-change-me

# JWT signing secrets. Each must be at least 32 characters and must not be the
# development placeholder from packages/shared.
PULSE_JWT_ACCESS_SECRET=pulse-chat-prod-demo-jwt-access-secret-min-32-chars
PULSE_JWT_REFRESH_SECRET=pulse-chat-prod-demo-jwt-refresh-secret-min-32-chars
PULSE_JWT_ACCESS_EXPIRES_IN=15m
PULSE_JWT_REFRESH_EXPIRES_IN=30d
