{
  "name": "@pulse-chat/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types, schemas and constants shared by the Pulse Chat frontend and backend",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@pulse-chat/config": "workspace:*",
    "@pulse-chat/eslint-config": "workspace:*",
    "eslint": "^10.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
