{
  "name": "@pulse-chat/api",
  "version": "0.0.0",
  "private": true,
  "description": "Pulse Chat NestJS backend",
  "license": "MIT",
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "node --watch --enable-source-maps --require @swc-node/register src/main.ts",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.2.1",
    "@pulse-chat/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "mongoose": "^8.16.4",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@pulse-chat/config": "workspace:*",
    "@pulse-chat/eslint-config": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.8.1",
    "ioredis-mock": "^8.9.0",
    "mongodb-memory-server": "^10.1.4",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.10"
  }
}
