# Copy to .env and adjust. .env is git-ignored and is never copied into an image.
#
# The development Docker stack in docker-compose.yml already provides sensible
# defaults for local work, so `docker compose up` works without this file.
# Create .env when you run services on the host or need to override a value.
#
# Production compose (docker-compose.prod.yml) does not read these unauthenticated
# store URLs. Copy .env.production.example to .env.production and pass
# `--env-file .env.production`, or rely on the compose file's local-demo defaults.
#
# Host names below are Docker service names. When you run the API directly on
# your machine while only the data stores are containerised, use localhost:
#   MONGODB_URI=mongodb://localhost:27017/pulse_chat
#   REDIS_URL=redis://localhost:6379

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development

# HTTP port the NestJS process listens on inside the container or on the host.
PORT=3000

# --- Data stores -------------------------------------------------------------
MONGODB_URI=mongodb://mongodb:27017/pulse_chat
REDIS_URL=redis://redis:6379

# --- Authentication ----------------------------------------------------------
# Required in production. In development and test, insecure public placeholders
# are applied automatically when these are left empty so the stack can start
# before the authentication phase is implemented.
#
# Generate one secret per variable, for example:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- HTTP --------------------------------------------------------------------
# Browser origin allowed by CORS. In the Docker development stack everything is
# served through nginx on one origin, so cross-origin requests are not made.
CORS_ORIGIN=http://localhost:8080

# --- File storage (specification section 18) ---------------------------------
# local | s3
FILE_STORAGE_PROVIDER=local
# Required when FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./storage

# --- Rate limiting (specification section 33) --------------------------------
# Redis fixed-window counters shared by every API instance.
# Login and registration are per client IP; the rest are per authenticated user.
# REST message creation and WebSocket message:send share RATE_LIMIT_MESSAGES.

# Login / registration attempts per IP within RATE_LIMIT_AUTH_WINDOW_SECONDS.
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Messages a user may send (HTTP POST or WebSocket message:send).
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_MESSAGES_WINDOW_SECONDS=10

# Message search requests per user.
RATE_LIMIT_SEARCH=30
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60

# File uploads per user (room attachments and avatars).
RATE_LIMIT_UPLOADS=10
RATE_LIMIT_UPLOADS_WINDOW_SECONDS=60
