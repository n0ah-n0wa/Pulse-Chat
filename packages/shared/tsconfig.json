{
  "extends": "@pulse-chat/config/tsconfig/library.json",
  "compilerOptions": {
    "noEmit": true
  },
  // Only src. Tooling configuration is deliberately kept out of this program:
  // build tools reference @types/node, which would put Node globals back in
  // scope and defeat the platform neutrality this package depends on.
  "include": ["src"]
}
